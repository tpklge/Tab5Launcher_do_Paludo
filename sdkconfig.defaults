# Tab5 Launcher — sdkconfig.defaults
# Target: ESP32-P4 (Tab5 ships silicon below v3.0)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# Flash: 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Bootloader: no OTA rollback (apps are switched by the launcher via otadata)
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set

# CPU and optimization
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# PSRAM: 32 MB octal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Task WDT: longer timeout for ESP-Hosted SPI handshake; no panic reboot on timeout
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_PANIC=n

# Console over USB-JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Misaligned access (RGB565 rows)

# M5Stack Tab5 BSP
CONFIG_BSP_ERROR_CHECK=n
CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL=n
CONFIG_BSP_SD_MOUNT_POINT="/sdcard"
CONFIG_BSP_LCD_USE_DMA2D=y
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=n
# 3 DPI buffers: PPA rotates 1280x720 logical into 720x1280 panel frame
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_LVGL_PORT_ENABLE_PPA=y
# IRAM-safe DSI ISR so DMA keeps running during flash erase/write
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# LVGL 9
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# Launcher uses SD records; Wi-Fi credentials are RAM + SD.
CONFIG_WIFI_RMT_NVS_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Default timezone (America/Cuiaba = UTC-4, no DST since Brazil abolished it in 2019)

# Stack sizes for key tasks (UI, workers)
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# esp_wifi_remote — required CONFIG_WIFI_RMT_* symbols for WIFI_INIT_CONFIG_DEFAULT()
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=10
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_WIFI_RMT_TX_BUFFER_TYPE=0
CONFIG_WIFI_RMT_DYNAMIC_RX_MGMT_BUF=0
CONFIG_WIFI_RMT_ESPNOW_MAX_ENCRYPT_NUM=7

# LVGL Montserrat fonts needed by UI
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y

# ESP-Hosted: coprocessor is ESP32-C6 via SDIO (not SPI)
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"

# Use SDIO slot 1 with explicit Tab5 pins (no modified dependency preset required).
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# ESP-Hosted ACTIVE_HIGH selects idle HIGH and a LOW reset pulse on GPIO15.
# CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW is not set

# esp_wifi_remote slave target
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_IDF_SPECIFIC_ADDED=y

CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

# CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE is not set

CONFIG_LV_USE_ASSERT_NULL=y

CONFIG_LV_USE_ASSERT_MALLOC=y

CONFIG_LV_ASSERT_HANDLER_INCLUDE="stdlib.h"

CONFIG_FATFS_LFN_HEAP=y

CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y

CONFIG_ESP_HOSTED_SDIO_SLOT_1=y

CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13

CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12

CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11

CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10

CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9

CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8

CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15

CONFIG_LV_USE_LODEPNG=y

CONFIG_LV_USE_TJPGD=y

CONFIG_LV_OS_FREERTOS=y

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# CONFIG_COMPILER_OPTIMIZATION_PERF is not set
CONFIG_LV_USE_SNAPSHOT=y

CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1536

CONFIG_LWIP_TCP_WND_DEFAULT=23040

CONFIG_LWIP_TCP_RECVMBOX_SIZE=18

CONFIG_LV_FONT_MONTSERRAT_18=y

CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_MSC_BUFSIZE=2048

CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH="/sdcard"
CONFIG_LV_FS_STDIO_CACHE_SIZE=0

CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
